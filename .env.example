# =========================================================================
# İHALECİBURADA.COM CANLI SİSTEM ÇEVRE DEĞİŞKENLERİ (.ENV.EXAMPLE)
# Bu dosyayı .env olarak kopyalayıp gerçek API anahtarlarınızı giriniz.
# =========================================================================

# 1. API ANAHTARLARI VE SECRET'LAR
# -------------------------------------------------------------------------
# 📧 CANLI SMTP GMAIL / KURUMSAL E-POSTA ENTEGRASYONU
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ihalecib@gmail.com
SMTP_PASSWORD=uygulama_ozel_sifresi
SMTP_ENCRYPTION=TLS
SENDER_EMAIL=ihalecib@gmail.com
SENDER_NAME="İhaleciBurada B2B Operasyon"
REPLY_TO_EMAIL=ihalecib@gmail.com

# 📱 NETGSM CANLI SMS BİLGİLERİ (OTP VE BİLDİRİM İLETİMİ)
NETGSM_USERCODE=8508408695
NETGSM_PASSWORD=sifreniz
NETGSM_HEADER=8508408695

# 💳 PAYTR & IYZICO SANAL POS VE ESCROW HAVUZ ENTEGRASYONU
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# 🤖 DEEPSEEK AI ENTEGRASYONU (ŞARTNAME OLUŞTURUCU & PROFİL ASİSTANI)
DEEPSEEK_API_KEY=

# -------------------------------------------------------------------------
# 5. GOOGLE ANALYTICS & SEARCH CONSOLE
# -------------------------------------------------------------------------
# Google Analytics 4 Ölçüm Kimliği (Örn: G-XXXXXXXXXX)
NUXT_PUBLIC_GA_ID=

# Google Search Console HTML Meta Doğrulama Kodu
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sitenin Yayın URL'si
NUXT_PUBLIC_SITE_URL=https://ihaleciburada.com
