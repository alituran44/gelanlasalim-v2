# 1. Ortam ve Uygulama Ayarları (SEC-016)
APP_ENV=production
NODE_ENV=production
PORT=3000

# 2. Resmî İşletme Bilgileri
MERCHANT_TRADE_NAME="Hasan Hüseyin Yıldırım (İhaleciBurada Ticari İşletmesi)"
MERCHANT_TAX_OFFICE="Çanakkale Vergi Dairesi"
MERCHANT_VKN="9560161511"
MERCHANT_KEP="hasanhuseyin.yildirim.17@hs01.kep.tr"
MERCHANT_PHONE="0850 840 86 95"
MERCHANT_EMAIL="ihalecib@gmail.com"

# 3. Google Mail Nodemailer SMTP Entegrasyonu (COM-002)
# Not: myaccount.google.com/apppasswords adresinden 16 haneli Uygulama Şifresi üretilmelidir.
GMAIL_USER=ihalecib@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# 4. NetGSM SMS & OTP Gönderim Servisi
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=IHALECIB

# 5. Sanal POS & Ödeme Entegrasyonu (PayTR / Paynkolay)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# 6. Güvenlik, Oturum & Token Şifreleme (SEC-007, SEC-010)
SESSION_SECRET=super_secret_session_encryption_key_change_in_production
HMAC_SECRET_KEY=super_secure_hmac_audit_key_change_in_production
